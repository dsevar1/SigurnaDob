<MudDialog>
    <TitleContent>@(ExistingActivity is null ? "Nova aktivnost" : "Uredi aktivnost")</TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_name" Label="Naziv" Required="true"
                          RequiredError="Naziv je obavezan." Disabled="_isSaving" Class="mb-2" />
            <MudTextField @bind-Value="_description" Label="Opis" Lines="3" Disabled="_isSaving" Class="mb-2" />
            <MudSelect T="int" @bind-Value="_activityTypeId" Label="Tip" Required="true"
                       RequiredError="Tip je obavezan." Disabled="_isSaving" Class="mb-2">
                @foreach (var type in ActivityTypes)
                {
                    <MudSelectItem T="int" Value="@type.Id">@type.Name</MudSelectItem>
                }
            </MudSelect>
            <MudGrid>
                <MudItem xs="6">
                    <MudDatePicker Label="Datum termina" @bind-Date="_scheduledAtDate" Required="true"
                                   RequiredError="Datum termina je obavezan." Disabled="_isSaving" />
                </MudItem>
                <MudItem xs="6">
                    <MudTimePicker Label="Vrijeme termina" @bind-Time="_scheduledAtTime" Required="true"
                                   RequiredError="Vrijeme termina je obavezno." Disabled="_isSaving" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isSaving">Odustani</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="_isSaving">
            @(_isSaving ? "Spremanje..." : "Spremi")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    public record ActivityFormResult(string Name, string? Description, int ActivityTypeId, DateTime ScheduledAt);

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ActivityDto? ExistingActivity { get; set; }
    [Parameter] public List<LookupDto> ActivityTypes { get; set; } = new();

    // Dijalog se zatvara SAMO na uspješan HTTP poziv u roditelju - vidi RoomFormDialog za obrazloženje.
    [Parameter, EditorRequired] public Func<ActivityFormResult, Task<bool>> OnSubmitAsync { get; set; } = null!;

    private MudForm _form = null!;
    private string _name = string.Empty;
    private string? _description;
    private int _activityTypeId;
    private DateTime? _scheduledAtDate;
    private TimeSpan? _scheduledAtTime;
    private bool _isSaving;

    protected override void OnInitialized()
    {
        if (ExistingActivity is { } activity)
        {
            _name = activity.Name;
            _description = activity.Description;
            _activityTypeId = activity.ActivityTypeId;
            _scheduledAtDate = activity.ScheduledAt.Date;
            _scheduledAtTime = activity.ScheduledAt.TimeOfDay;
        }
        else
        {
            if (ActivityTypes.Count > 0)
            {
                _activityTypeId = ActivityTypes[0].Id;
            }
            _scheduledAtDate = DateTime.Today;
            _scheduledAtTime = DateTime.Now.TimeOfDay;
        }
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        var scheduledAt = _scheduledAtDate!.Value.Date + _scheduledAtTime!.Value;
        var result = new ActivityFormResult(_name, _description, _activityTypeId, scheduledAt);

        _isSaving = true;
        try
        {
            var success = await OnSubmitAsync(result);
            if (success)
            {
                MudDialog.Close(DialogResult.Ok(result));
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
