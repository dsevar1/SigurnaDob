<MudDialog>
    <TitleContent>@(ExistingContact is null ? "Novi obiteljski kontakt" : "Uredi obiteljski kontakt")</TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_fullName" Label="Ime i prezime" Required="true"
                          RequiredError="Ime i prezime su obavezni." Disabled="_isSaving" Class="mb-2" />
            <MudTextField @bind-Value="_relationship" Label="Srodstvo" Disabled="_isSaving" Class="mb-2" />
            <MudTextField @bind-Value="_phone" Label="Telefon" Disabled="_isSaving" Class="mb-2" />
            <MudTextField @bind-Value="_email" Label="Email" Disabled="_isSaving" Class="mb-2" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isSaving">Odustani</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="_isSaving">
            @(_isSaving ? "Spremanje..." : "Spremi")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    public record FamilyContactFormResult(string FullName, string? Relationship, string? Phone, string? Email);

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public FamilyContactDto? ExistingContact { get; set; }

    // Dijalog se zatvara SAMO na uspješan HTTP poziv u roditelju - vidi RoomFormDialog za obrazloženje.
    [Parameter, EditorRequired] public Func<FamilyContactFormResult, Task<bool>> OnSubmitAsync { get; set; } = null!;

    private MudForm _form = null!;
    private string _fullName = string.Empty;
    private string? _relationship;
    private string? _phone;
    private string? _email;
    private bool _isSaving;

    protected override void OnInitialized()
    {
        if (ExistingContact is { } contact)
        {
            _fullName = contact.FullName;
            _relationship = contact.Relationship;
            _phone = contact.Phone;
            _email = contact.Email;
        }
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        var result = new FamilyContactFormResult(_fullName, _relationship, _phone, _email);

        _isSaving = true;
        try
        {
            var success = await OnSubmitAsync(result);
            if (success)
            {
                MudDialog.Close(DialogResult.Ok(result));
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
