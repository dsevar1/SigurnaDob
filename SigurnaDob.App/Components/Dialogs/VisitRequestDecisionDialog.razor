<MudDialog>
    <TitleContent>@Title</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_decisionNote" Label="Napomena (neobavezno)" Lines="3" Disabled="_isSaving" Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isSaving">Odustani</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="_isSaving">
            @(_isSaving ? "Spremanje..." : "Potvrdi")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    public record VisitRequestDecisionResult(string? DecisionNote);

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    // Dijalog se zatvara SAMO na uspješan HTTP poziv u roditelju - vidi RoomFormDialog za obrazloženje.
    [Parameter, EditorRequired] public Func<VisitRequestDecisionResult, Task<bool>> OnSubmitAsync { get; set; } = null!;

    private string? _decisionNote;
    private bool _isSaving;

    private async Task Submit()
    {
        var result = new VisitRequestDecisionResult(_decisionNote);

        _isSaving = true;
        try
        {
            var success = await OnSubmitAsync(result);
            if (success)
            {
                MudDialog.Close(DialogResult.Ok(result));
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
