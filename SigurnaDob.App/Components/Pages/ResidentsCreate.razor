@page "/residents/create"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Novi korisnik doma</PageTitle>

<AuthorizeView Roles="Admin,Coordinator">
    <Authorized>
        <MudText Typo="Typo.h4" Class="mb-4">Novi korisnik doma</MudText>

        <MudPaper Class="pa-4" MaxWidth="600px">
            <MudForm @ref="_form">
                <ResidentFormFields Model="_model" ResidentStatuses="_residentStatuses" Rooms="_rooms" />
            </MudForm>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_errorMessage</MudAlert>
            }

            <div class="d-flex mt-4">
                <MudButton Variant="Variant.Outlined" Class="mr-2" OnClick="@(() => Navigation.NavigateTo("/residents"))">Odustani</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_isSaving">
                    @(_isSaving ? "Spremanje..." : "Spremi")
                </MudButton>
            </div>
        </MudPaper>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning">Nemaš ovlasti za kreiranje korisnika doma.</MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    private MudForm _form = null!;
    private readonly ResidentFormFields.ResidentFormModel _model = new();
    private List<LookupDto> _residentStatuses = new();
    private List<RoomDto> _rooms = new();
    private string? _errorMessage;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _residentStatuses = await Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/resident-statuses") ?? new();
            _rooms = await Http.GetFromJsonAsync<List<RoomDto>>("api/rooms") ?? new();

            if (_residentStatuses.Count > 0)
            {
                _model.ResidentStatusId = _residentStatuses[0].Id;
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Ne mogu dohvatiti šifrarnike. Provjeri je li API pokrenut.", Severity.Error);
        }
    }

    private async Task SubmitAsync()
    {
        _errorMessage = null;
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _isSaving = true;
        try
        {
            var dto = new ResidentCreateDto
            {
                FullName = _model.FullName,
                DateOfBirth = _model.DateOfBirth is null ? null : DateOnly.FromDateTime(_model.DateOfBirth.Value),
                ResidentStatusId = _model.ResidentStatusId,
                RoomId = _model.RoomId,
                AdmissionDate = _model.AdmissionDate is null ? null : DateOnly.FromDateTime(_model.AdmissionDate.Value)
            };

            var response = await Http.PostAsJsonAsync("api/residents", dto);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Korisnik doma je kreiran.", Severity.Success);
                Navigation.NavigateTo("/residents");
            }
            else
            {
                _errorMessage = await response.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(_errorMessage))
                {
                    _errorMessage = "Greška prilikom kreiranja korisnika doma.";
                }
            }
        }
        finally
        {
            _isSaving = false;
        }
    }
}
