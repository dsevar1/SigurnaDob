@page "/residents/{Id:int}"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>Profil korisnika doma</PageTitle>

<AuthorizeView Roles="Admin,Coordinator">
    <Authorized>
        @if (_notFound)
        {
            <MudAlert Severity="Severity.Error">Korisnik doma nije pronađen.</MudAlert>
        }
        else if (_resident is null)
        {
            <MudText>Učitavanje...</MudText>
        }
        else
        {
            <MudText Typo="Typo.h4" Class="mb-4">@_resident.FullName</MudText>

            <MudPaper Class="pa-4" MaxWidth="600px">
                <MudSimpleTable Dense="true">
                    <tbody>
                        <tr>
                            <td><strong>Datum rođenja</strong></td>
                            <td>@(_resident.DateOfBirth?.ToString("dd.MM.yyyy") ?? "—")</td>
                        </tr>
                        <tr>
                            <td><strong>Status</strong></td>
                            <td>@_resident.ResidentStatusName</td>
                        </tr>
                        <tr>
                            <td><strong>Soba</strong></td>
                            <td>@(_resident.RoomNumber ?? "—")</td>
                        </tr>
                        <tr>
                            <td><strong>Datum prijema</strong></td>
                            <td>@(_resident.AdmissionDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                        </tr>
                    </tbody>
                </MudSimpleTable>

                <div class="d-flex mt-4">
                    <MudButton Variant="Variant.Outlined" Class="mr-2" OnClick="@(() => Navigation.NavigateTo("/residents"))">Natrag</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo($"/residents/{Id}/edit"))">Uredi</MudButton>
                </div>
            </MudPaper>

            <div class="d-flex align-center mt-8 mb-2">
                <MudText Typo="Typo.h5">Obiteljski kontakti</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateContactDialogAsync">
                    Dodaj kontakt
                </MudButton>
            </div>

            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                    <tr>
                        <th>Ime i prezime</th>
                        <th>Srodstvo</th>
                        <th>Telefon</th>
                        <th>Email</th>
                        <th>Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_familyContacts.Count == 0)
                    {
                        <tr>
                            <td colspan="5"><MudText>Nema unesenih obiteljskih kontakata.</MudText></td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var contact in _familyContacts)
                        {
                            <tr>
                                <td>@contact.FullName</td>
                                <td>@(contact.Relationship ?? "—")</td>
                                <td>@(contact.Phone ?? "—")</td>
                                <td>@(contact.Email ?? "—")</td>
                                <td>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   OnClick="@(() => OpenEditContactDialogAsync(contact))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => DeleteContactAsync(contact))" />
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </MudSimpleTable>

            <div class="d-flex align-center mt-8 mb-2">
                <MudText Typo="Typo.h5">Dokumenti</MudText>
            </div>

            <MudSimpleTable Dense="true" Hover="true" Class="mb-2">
                <thead>
                    <tr>
                        <th>Naziv</th>
                        <th>Tip</th>
                        <th>Veličina</th>
                        <th>Datum uploada</th>
                        <th>Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_documents.Count == 0)
                    {
                        <tr>
                            <td colspan="5"><MudText>Nema uploadanih dokumenata.</MudText></td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var document in _documents)
                        {
                            <tr>
                                <td>@document.OriginalFileName</td>
                                <td>@FormatDocumentType(document.ContentType)</td>
                                <td>@FormatFileSize(document.FileSizeBytes)</td>
                                <td>@document.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small"
                                                   OnClick="@(() => DownloadDocumentAsync(document))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => DeleteDocumentAsync(document))" />
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </MudSimpleTable>

            <MudFileUpload T="IBrowserFile" @ref="_fileUpload" FilesChanged="OnFileSelectedAsync"
                            Accept=".pdf,.jpg,.jpeg,.png" MaxFileSize="@MaxUploadSizeBytes" Disabled="_uploading">
                <CustomContent Context="uploadContext">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload"
                               Disabled="_uploading" OnClick="@(() => uploadContext.OpenFilePickerAsync())">
                        @(_uploading ? "Upload u tijeku..." : "Dodaj dokument")
                    </MudButton>
                </CustomContent>
            </MudFileUpload>
            <MudText Typo="Typo.body2" Class="mt-1">Dopušteni tipovi: PDF, JPG, PNG. Maksimalna veličina: 10 MB.</MudText>
        }
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning">Nemaš ovlasti za pregled profila korisnika doma.</MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public int Id { get; set; }

    private const long MaxUploadSizeBytes = 10 * 1024 * 1024; // 10 MB - mora odgovarati limitu na Api strani

    private ResidentDto? _resident;
    private bool _notFound;
    private List<FamilyContactDto> _familyContacts = new();
    private List<ResidentDocumentDto> _documents = new();
    private MudFileUpload<IBrowserFile> _fileUpload = null!;
    private bool _uploading;

    protected override async Task OnInitializedAsync()
    {
        HttpResponseMessage response;
        try
        {
            response = await Http.GetAsync($"api/residents/{Id}");
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Ne mogu dohvatiti podatke. Provjeri je li API pokrenut.", Severity.Error);
            return;
        }

        if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _notFound = true;
            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            // 401/403 - <AuthorizeView> u markupu već prikazuje odgovarajuću poruku, ne treba dupli snackbar.
            return;
        }

        _resident = await response.Content.ReadFromJsonAsync<ResidentDto>();
        await LoadFamilyContactsAsync();
        await LoadDocumentsAsync();
    }

    private async Task LoadFamilyContactsAsync()
    {
        try
        {
            var response = await Http.GetAsync($"api/residents/{Id}/family-contacts");
            if (response.IsSuccessStatusCode)
            {
                _familyContacts = await response.Content.ReadFromJsonAsync<List<FamilyContactDto>>() ?? new();
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Ne mogu dohvatiti obiteljske kontakte. Provjeri je li API pokrenut.", Severity.Error);
        }
    }

    private async Task OpenCreateContactDialogAsync()
    {
        var parameters = new DialogParameters();
        parameters.Add(nameof(FamilyContactFormDialog.ExistingContact), null);
        parameters.Add(nameof(FamilyContactFormDialog.OnSubmitAsync), (Func<FamilyContactFormDialog.FamilyContactFormResult, Task<bool>>)CreateContactAsync);

        var dialog = await DialogService.ShowAsync<FamilyContactFormDialog>("Novi obiteljski kontakt", parameters);
        await dialog.Result;
    }

    private async Task OpenEditContactDialogAsync(FamilyContactDto contact)
    {
        var parameters = new DialogParameters();
        parameters.Add(nameof(FamilyContactFormDialog.ExistingContact), contact);
        parameters.Add(nameof(FamilyContactFormDialog.OnSubmitAsync), (Func<FamilyContactFormDialog.FamilyContactFormResult, Task<bool>>)(data => UpdateContactAsync(contact.Id, data)));

        var dialog = await DialogService.ShowAsync<FamilyContactFormDialog>("Uredi obiteljski kontakt", parameters);
        await dialog.Result;
    }

    private async Task<bool> CreateContactAsync(FamilyContactFormDialog.FamilyContactFormResult data)
    {
        var dto = new FamilyContactCreateDto
        {
            FullName = data.FullName,
            Relationship = data.Relationship,
            Phone = data.Phone,
            Email = data.Email
        };

        var response = await Http.SafeSendAsync(Snackbar, () => Http.PostAsJsonAsync($"api/residents/{Id}/family-contacts", dto));
        if (response is null)
        {
            return false;
        }

        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("Obiteljski kontakt je dodan.", Severity.Success);
            await LoadFamilyContactsAsync();
            return true;
        }

        await ShowErrorAsync(response, "Greška prilikom dodavanja kontakta.");
        return false;
    }

    private async Task<bool> UpdateContactAsync(int contactId, FamilyContactFormDialog.FamilyContactFormResult data)
    {
        var dto = new FamilyContactUpdateDto
        {
            FullName = data.FullName,
            Relationship = data.Relationship,
            Phone = data.Phone,
            Email = data.Email
        };

        var response = await Http.SafeSendAsync(Snackbar, () => Http.PutAsJsonAsync($"api/residents/{Id}/family-contacts/{contactId}", dto));
        if (response is null)
        {
            return false;
        }

        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("Obiteljski kontakt je ažuriran.", Severity.Success);
            await LoadFamilyContactsAsync();
            return true;
        }

        await ShowErrorAsync(response, "Greška prilikom ažuriranja kontakta.");
        return false;
    }

    private async Task DeleteContactAsync(FamilyContactDto contact)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Potvrda brisanja",
            $"Jesi li siguran/na da želiš obrisati kontakt {contact.FullName}?",
            yesText: "Obriši", cancelText: "Odustani");

        if (confirmed != true)
        {
            return;
        }

        var response = await Http.SafeSendAsync(Snackbar, () => Http.DeleteAsync($"api/residents/{Id}/family-contacts/{contact.Id}"));
        if (response is null)
        {
            return;
        }

        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("Obiteljski kontakt je obrisan.", Severity.Success);
            await LoadFamilyContactsAsync();
        }
        else
        {
            await ShowErrorAsync(response, "Greška prilikom brisanja kontakta.");
        }
    }

    private async Task LoadDocumentsAsync()
    {
        try
        {
            var response = await Http.GetAsync($"api/residents/{Id}/documents");
            if (response.IsSuccessStatusCode)
            {
                _documents = await response.Content.ReadFromJsonAsync<List<ResidentDocumentDto>>() ?? new();
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Ne mogu dohvatiti dokumente. Provjeri je li API pokrenut.", Severity.Error);
        }
    }

    private async Task OnFileSelectedAsync(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }

        _uploading = true;
        try
        {
            using var content = new MultipartFormDataContent();

            // maxAllowedSize MORA biti veći od Api-jevog limita (10 MB) - IBrowserFile.OpenReadStream() ima
            // vlastiti default limit od samo 500 KB i baca IOException prije nego podaci uopće stignu do Api-ja.
            using var fileStream = file.OpenReadStream(maxAllowedSize: MaxUploadSizeBytes + 1);
            using var streamContent = new StreamContent(fileStream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(streamContent, "file", file.Name);

            var response = await Http.SafeSendAsync(Snackbar, () => Http.PostAsync($"api/residents/{Id}/documents", content));
            if (response is null)
            {
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Dokument je dodan.", Severity.Success);
                await LoadDocumentsAsync();
            }
            else
            {
                await ShowErrorAsync(response, "Greška prilikom uploada dokumenta.");
            }
        }
        catch (IOException)
        {
            Snackbar.Add("Datoteka je prevelika.", Severity.Error);
        }
        finally
        {
            _uploading = false;
            await _fileUpload.ClearAsync();
        }
    }

    private async Task DownloadDocumentAsync(ResidentDocumentDto document)
    {
        var response = await Http.SafeSendAsync(Snackbar, () => Http.GetAsync($"api/residents/{Id}/documents/{document.Id}/download"));
        if (response is null)
        {
            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            await ShowErrorAsync(response, "Greška prilikom preuzimanja dokumenta.");
            return;
        }

        var fileStream = await response.Content.ReadAsStreamAsync();
        using var streamRef = new DotNetStreamReference(fileStream);
        await JS.InvokeVoidAsync("downloadFileFromStream", document.OriginalFileName, streamRef);
    }

    private async Task DeleteDocumentAsync(ResidentDocumentDto document)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Potvrda brisanja",
            $"Jesi li siguran/na da želiš obrisati dokument {document.OriginalFileName}?",
            yesText: "Obriši", cancelText: "Odustani");

        if (confirmed != true)
        {
            return;
        }

        var response = await Http.SafeSendAsync(Snackbar, () => Http.DeleteAsync($"api/residents/{Id}/documents/{document.Id}"));
        if (response is null)
        {
            return;
        }

        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("Dokument je obrisan.", Severity.Success);
            await LoadDocumentsAsync();
        }
        else
        {
            await ShowErrorAsync(response, "Greška prilikom brisanja dokumenta.");
        }
    }

    private static string FormatFileSize(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB" };
        double size = bytes;
        var unitIndex = 0;

        while (size >= 1024 && unitIndex < units.Length - 1)
        {
            size /= 1024;
            unitIndex++;
        }

        return unitIndex == 0 ? $"{size:0} {units[unitIndex]}" : $"{size:0.0} {units[unitIndex]}";
    }

    private static string FormatDocumentType(string contentType)
    {
        return contentType.ToLowerInvariant() switch
        {
            "application/pdf" => "PDF",
            "image/jpeg" => "JPG",
            "image/png" => "PNG",
            _ => contentType
        };
    }

    private async Task ShowErrorAsync(HttpResponseMessage response, string fallbackMessage)
    {
        var message = await response.Content.ReadAsStringAsync();
        Snackbar.Add(string.IsNullOrWhiteSpace(message) ? fallbackMessage : message, Severity.Error);
    }
}
