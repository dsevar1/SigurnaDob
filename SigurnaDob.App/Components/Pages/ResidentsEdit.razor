@page "/residents/{Id:int}/edit"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Uredi korisnika doma</PageTitle>

<AuthorizeView Roles="Admin,Coordinator">
    <Authorized>
        <MudText Typo="Typo.h4" Class="mb-4">Uredi korisnika doma</MudText>

        @if (_notFound)
        {
            <MudAlert Severity="Severity.Error">Korisnik doma nije pronađen.</MudAlert>
        }
        else if (_loading)
        {
            <MudText>Učitavanje...</MudText>
        }
        else
        {
            <MudPaper Class="pa-4" MaxWidth="600px">
                <MudForm @ref="_form">
                    <ResidentFormFields Model="_model" ResidentStatuses="_residentStatuses" Rooms="_rooms" />
                </MudForm>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2">@_errorMessage</MudAlert>
                }

                <div class="d-flex mt-4">
                    <MudButton Variant="Variant.Outlined" Class="mr-2" OnClick="@(() => Navigation.NavigateTo($"/residents/{Id}"))">Odustani</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_isSaving">
                        @(_isSaving ? "Spremanje..." : "Spremi")
                    </MudButton>
                </div>
            </MudPaper>
        }
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning">Nemaš ovlasti za uređivanje korisnika doma.</MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public int Id { get; set; }

    private MudForm _form = null!;
    private readonly ResidentFormFields.ResidentFormModel _model = new();
    private List<LookupDto> _residentStatuses = new();
    private List<RoomDto> _rooms = new();
    private string? _errorMessage;
    private bool _isSaving;
    private bool _loading = true;
    private bool _notFound;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _residentStatuses = await Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/resident-statuses") ?? new();
            _rooms = await Http.GetFromJsonAsync<List<RoomDto>>("api/rooms") ?? new();

            var response = await Http.GetAsync($"api/residents/{Id}");
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _notFound = true;
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                // 401/403 - <AuthorizeView> u markupu već prikazuje odgovarajuću poruku, ne treba dupli snackbar.
                return;
            }

            var resident = await response.Content.ReadFromJsonAsync<ResidentDto>();
            if (resident is not null)
            {
                _model.FullName = resident.FullName;
                _model.DateOfBirth = resident.DateOfBirth?.ToDateTime(TimeOnly.MinValue);
                _model.ResidentStatusId = resident.ResidentStatusId;
                _model.RoomId = resident.RoomId;
                _model.AdmissionDate = resident.AdmissionDate?.ToDateTime(TimeOnly.MinValue);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Ne mogu dohvatiti podatke. Provjeri je li API pokrenut.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SubmitAsync()
    {
        _errorMessage = null;
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _isSaving = true;
        try
        {
            var dto = new ResidentUpdateDto
            {
                FullName = _model.FullName,
                DateOfBirth = _model.DateOfBirth is null ? null : DateOnly.FromDateTime(_model.DateOfBirth.Value),
                ResidentStatusId = _model.ResidentStatusId,
                RoomId = _model.RoomId,
                AdmissionDate = _model.AdmissionDate is null ? null : DateOnly.FromDateTime(_model.AdmissionDate.Value)
            };

            var response = await Http.PutAsJsonAsync($"api/residents/{Id}", dto);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Korisnik doma je ažuriran.", Severity.Success);
                Navigation.NavigateTo($"/residents/{Id}");
            }
            else
            {
                _errorMessage = await response.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(_errorMessage))
                {
                    _errorMessage = "Greška prilikom ažuriranja korisnika doma.";
                }
            }
        }
        finally
        {
            _isSaving = false;
        }
    }
}
